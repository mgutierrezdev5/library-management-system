{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Run Library Project",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "\"C:\\vscode\\MinGW\\bin\\g++.exe\" src\\main.c src\\book.c src\\menu.c src\\file_manager.c -Iinclude -o library.exe && library.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\vscode\\MinGW\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}